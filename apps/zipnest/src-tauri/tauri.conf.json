{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZipNest",
  "version": "0.1.0",
  "identifier": "com.zipnest.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZipNest",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "resources": {
      "resources/engines/7z.dll": "engines/7z.dll",
      "resources/engines/sfx/7z.sfx": "engines/sfx/7z.sfx",
      "resources/engines/sfx/7zCon.sfx": "engines/sfx/7zCon.sfx",
      "resources/licenses/7zip.txt": "licenses/7zip.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
