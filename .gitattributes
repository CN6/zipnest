# 换行/字节敏感的文件：禁止 Git 做任何文本转换
# （installer.nsi 依赖开头的 UTF-8 BOM 和 CRLF，被转换过一次就会出问题）
*.nsi -text
*.nsh -text
*.bat -text
*.cmd -text
*.ps1 -text

# 二进制文件：不做文本 diff / 合并，避免被当文本处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
*.msi binary
*.zip binary
*.7z binary
*.rar binary
*.tar binary
*.gz binary
*.xz binary

# 锁文件：不参与 diff（体量大，且改它没意义）
Cargo.lock -diff
pnpm-lock.yaml -diff
