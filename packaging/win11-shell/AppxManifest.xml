<?xml version="1.0" encoding="utf-8"?>
<!--
  ZipNest Windows 11 shell integration (sparse / packaging-with-external-location).

  The package itself carries only this manifest + Assets\*. The real binaries
  (zipnest.exe, zipnest_shell.dll) live in the app's install directory and are
  linked at registration time:

      Add-AppxPackage -Path ZipNestShell.msix -ExternalLocation <install dir> -AllowUnsigned

  Per-user only: no HKLM, no certificate, no classic-menu toggle.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">

  <Identity
    Name="ZipNest.Shell"
    Publisher="CN=ZipNest"
    Version="0.4.13.0"
    ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>ZipNest</DisplayName>
    <PublisherDisplayName>ZipNest contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-cn" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <!-- Executable resolves inside the external location; the entry point is
         never invoked directly (the shell command CreateProcess'es it), but the
         Application node is required to host the extensions. -->
    <Application
      Id="ZipNestShell"
      Executable="zipnest.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="ZipNest"
        Description="ZipNest creation and extraction utilities"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- The IExplorerCommand implementation lives in zipnest_shell.dll. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer
              AppId="9F2C4E17-6A3B-4D58-8E21-5B7C0D9A4F33"
              DisplayName="ZipNestExplorerCommand">
              <com:Class
                Id="9F2C4E17-6A3B-4D58-8E21-5B7C0D9A4F33"
                Path="zipnest_shell.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!-- Windows 11 modern context menu entries. All real-world examples use
             desktop5:ItemType (its Type accepts `*`, `Directory`, and
             `Directory\Background`); desktop4:ItemType only accepts `.ext`/`*`. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="ZipNestAdd" Clsid="9F2C4E17-6A3B-4D58-8E21-5B7C0D9A4F33" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="ZipNestAdd" Clsid="9F2C4E17-6A3B-4D58-8E21-5B7C0D9A4F33" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="ZipNestAdd" Clsid="9F2C4E17-6A3B-4D58-8E21-5B7C0D9A4F33" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
